# Public Firebase web config (not secret). Copy to .env.local for local dev, or set as repository
# secrets for the GitHub Pages deploy. Leave unset to run fully local, with no sign-in and no sync.
#
# Firebase console -> Project settings -> Your apps -> Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Base path for a GitHub project page (https://<user>.github.io/tprg-sheets/).
# VITE_BASE=/tprg-sheets/
