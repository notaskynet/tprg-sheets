rules_version = '2';

// Sheets and imported systems live under /users/{uid}, readable and writable only by their owner.
// Sharing with other people goes through /shares (live links), snapshot links and live sessions.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Live read-only links: whoever holds the unguessable id can read that one document; only its
    // owner can list their links, write them, or switch them off.
    match /shares/{shareId} {
      allow get: if true;
      allow list: if request.auth != null && resource.data.owner == request.auth.uid;
      allow create, update: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }
  }
}
