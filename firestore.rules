rules_version = '2';

// Everything lives under /users/{uid}: sheets and imported systems, readable and writable only by
// their owner. Sharing with other people goes through snapshot links and live sessions instead.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
