{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "roll": {
      "type": "object",
      "properties": {},
      "additionalProperties": {}
    },
    "sections": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_]+$"
          },
          "title": {
            "type": "string"
          },
          "columns": {
            "default": 1,
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "when": {
            "type": "string",
            "minLength": 1
          },
          "blocks": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string"
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": {}
            }
          }
        },
        "required": [
          "id"
        ]
      }
    }
  },
  "title": "trpg-sheets sheet.toml"
}
